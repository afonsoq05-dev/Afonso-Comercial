  "formulas": [
    {
      "id": "field_capacity",
      "label": "Capacidade teórica de campo",
      "formula": "workingWidthM * workingSpeedKmH / 10",
      "unit": "ha/h",
      "assumptions": "Não inclui perdas operacionais."
    },
    {
      "id": "effective_field_capacity",
      "label": "Capacidade efetiva estimada",
      "formula": "workingWidthM * workingSpeedKmH * (fieldEfficiencyPct / 100) / 10",
      "unit": "ha/h",
      "assumptions": "Eficiência precisa refletir formato do talhão, manobras, abastecimento, regulagens e paradas."
    },
    {
      "id": "hours_required",
      "label": "Horas estimadas",
      "formula": "areaHa / effectiveFieldCapacityHaH",
      "unit": "h",
      "assumptions": "Estimativa operacional; não é garantia de produtividade."
    },
    {
      "id": "spray_rate",
      "label": "Volume de calda total",
      "formula": "areaHa * applicationRateLHa",
      "unit": "L",
      "assumptions": "A dose e a taxa de aplicação devem ser definidas tecnicamente conforme produto, cultura e recomendação agronômica."
    },
    {
      "id": "harvest_mass",
      "label": "Massa total estimada para colher",
      "formula": "areaHa * yieldTHa",
      "unit": "t",
      "assumptions": "Produtividade informada pelo usuário; capacidade real depende de cultura, umidade, perdas, relevo e logística."
    }
  ],
